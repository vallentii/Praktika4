<Window x:Class="Praktika4.Elements.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Praktika4.Elements"
        mc:Ignorable="d"
        Title="Изменить данные" Background="black" Height="450" Width="400" MinHeight="450" MinWidth="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Label Content="Имя" Foreground="White" HorizontalContentAlignment="Center" Margin="10,5,10,5"/>
        <Label Content="Фамилия" Foreground="White" HorizontalContentAlignment="Center" Margin="10,5,10,5" Grid.Row="2"/>
        <Label Content="Отчество" Foreground="White" HorizontalContentAlignment="Center" Margin="10,5,10,5" Grid.Row="4"/>
        <Label Content="Стипендия" Foreground="White" HorizontalContentAlignment="Center" Margin="10,5,10,5" Grid.Row="6"/>
        <Label Content="Курс" Foreground="White" HorizontalContentAlignment="Center" Margin="10,5,10,5" Grid.Row="8"/>
        <TextBox x:Name="name" Margin="10"  Grid.Row="1"/>
        <TextBox x:Name="lastname" Margin="10"  Grid.Row="3"/>
        <TextBox x:Name="lastlastname" Margin="10"  Grid.Row="5"/>
        <TextBox x:Name="kurs" Margin="10"  Grid.Row="9"/>
        <CheckBox Content="Есть" x:Name="scholarshipCheak" Foreground="White" Margin="10" Grid.Row="7"/>
        <Button Content="Сохранить" Click="Join" Background="white" Margin="10" Grid.Row="10"/>
    </Grid>
</Window>
