<Window x:Class="Praktika4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Praktika4"
        mc:Ignorable="d"
        Title="Студенты" Height="450" Width="800" MinHeight="450" MinWidth="800" FontFamily="Arial Narrow">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="search" Grid.Row="0" Margin="10" Height="30" FontSize="14" VerticalContentAlignment="Center" TextChanged="Search_Students"/>
        <ScrollViewer Grid.Row="1" ScrollChanged="ScrollViewer_ScrollChanged">
            <StackPanel Margin="10" x:Name="parent">
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
